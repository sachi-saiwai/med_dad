# Automatically provided by the Vercel Neon integration.
DATABASE_URL=
# The Neon Marketplace may instead create database_DATABASE_URL.

# Automatically provided by the connected private Vercel Blob store.
BLOB_READ_WRITE_TOKEN=

# Create independent random strings of at least 16 characters in Vercel.
CRON_SECRET=
SYNC_ADMIN_TOKEN=

# Firebase Authentication project used by the Flutter clients.
FIREBASE_PROJECT_ID=

# Optional access and Web Push settings.
REQUIRE_INVITE_CODE=false
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=

# Optional. Enables structured certificate extraction and official-document diff summaries.
OPENAI_API_KEY=
# Override only when changing the deployed OpenAI model.
OPENAI_MODEL=gpt-5.6-luna
